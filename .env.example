# =============================================================================
# Enrichment Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file must never be committed to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Enrichment API keys (optional — pipeline works without them using free mode)
# -----------------------------------------------------------------------------

# Clearbit: https://dashboard.clearbit.com/api
CLEARBIT_API_KEY=

# Apollo.io: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# Hunter.io: https://hunter.io/api-keys
HUNTER_API_KEY=

# -----------------------------------------------------------------------------
# Runtime settings (optional overrides)
# -----------------------------------------------------------------------------

# Default enrichment provider: free | clearbit | apollo | hunter
# ENRICHMENT_PROVIDER=free

# Requests per second ceiling for external API calls
# RATE_LIMIT=3

# Number of concurrent enrichment workers
# CONCURRENCY=5

# Path to SQLite cache file
# CACHE_PATH=./cache/cache.sqlite
